# ============================================================
# SIMWT Mobile — template environment variable
# Salin ke `.env` lalu isi nilainya: cp .env.example .env
# ------------------------------------------------------------
# Expo hanya mem-bundle variabel yang berawalan EXPO_PUBLIC_.
#
# ⚠️ PERINGATAN: nilai EXPO_PUBLIC_* di-INLINE sebagai teks biasa ke dalam
# bundle JavaScript saat build. Siapa pun yang membongkar APK/IPA bisa
# membacanya. Jadi file ini BUKAN tempat menyimpan rahasia sungguhan —
# hanya untuk konfigurasi yang memang boleh diketahui klien.
# Token hasil login tetap disimpan di expo-secure-store, bukan di sini.
#
# Template ini sengaja dibiarkan KOSONG. Jangan commit nilai asli.
# ============================================================

# true  = pakai Laravel lokal (Laragon)
# false = pakai server production
# (kosong = dianggap true)
EXPO_PUBLIC_USE_LOCAL_API=

# --- Target LOKAL -------------------------------------------
# Port vhost LAN api-simwt di Laragon. (kosong = 8000)
EXPO_PUBLIC_LOCAL_API_PORT=

# IP Wi-Fi laptop. Hanya dipakai sebagai cadangan kalau host dev server Expo
# tidak terdeteksi (mis. build standalone/APK). Saat pakai Expo Go, IP
# terdeteksi otomatis sehingga boleh dikosongkan.
EXPO_PUBLIC_LOCAL_API_HOST=

# --- Target PRODUCTION --------------------------------------
# URL dasar API production, berakhiran /api
EXPO_PUBLIC_API_BASE_URL=

# --- Kredensial ---------------------------------------------
# Header X-SIMMWT-KEY. Nilainya = MWTPART_WEB_TOKEN di .env api-simwt.
EXPO_PUBLIC_API_TOKEN=

# Timeout request axios dalam milidetik. (kosong = 30000)
EXPO_PUBLIC_API_TIMEOUT=
