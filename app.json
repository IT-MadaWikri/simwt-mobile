{
  "expo": {
    "name": "SIMWT Mobile",
    "slug": "simwt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simwtmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.id.mwtpart.simwt"
    },
    "android": {
      "package": "co.id.mwtpart.simwt",
      "adaptiveIcon": {
        "backgroundColor": "#00880F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#00880F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan SIMWT mengakses foto untuk lampiran Kaizen.",
          "cameraPermission": "Izinkan SIMWT memakai kamera untuk foto Kaizen."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "12219d51-f42c-48d1-b4c8-9f482d512144"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/12219d51-f42c-48d1-b4c8-9f482d512144"
    }
  }
}
